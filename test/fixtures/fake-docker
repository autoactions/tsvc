#!/usr/bin/env node

import { appendFileSync, chmodSync, copyFileSync, existsSync, readFileSync, unlinkSync, writeFileSync } from "node:fs";

const args = process.argv.slice(2);
appendFileSync(process.env.FAKE_DOCKER_LOG, `${JSON.stringify(args)}\n`);
const stoppedMarker = `${process.env.FAKE_DOCKER_LOG}.stopped`;
const openlistPreparedMarker = `${process.env.FAKE_DOCKER_LOG}.openlist-prepared`;
const openlistAdminState = `${process.env.FAKE_DOCKER_LOG}.openlist-admin`;

switch (args[0]) {
  case "pull":
    break;
  case "create":
    process.stdout.write("fake-extraction-container\n");
    break;
  case "cp":
    if (!process.env.FAKE_RCLONE_FIXTURE || !args[2]) process.exitCode = 2;
    else {
      copyFileSync(process.env.FAKE_RCLONE_FIXTURE, args[2]);
      chmodSync(args[2], 0o700);
    }
    break;
  case "stop":
    writeFileSync(stoppedMarker, "stopped");
    break;
  case "rm":
    break;
  case "volume":
    if (args[1] === "create") process.stdout.write(`${args[2]}\n`);
    else if (args[1] !== "rm") process.exitCode = 2;
    break;
  case "run":
    if (args.includes("--detach") && existsSync(stoppedMarker)) unlinkSync(stoppedMarker);
    if (args.some((argument) => argument.endsWith("-openlist-permissions"))) {
      const mounts = args.filter((argument) => argument.startsWith("type=bind,source=") && argument.includes("target=/run/secrets/"));
      const sources = mounts.map((mount) => mount.match(/(?:^|,)source=([^,]+),target=/)?.[1]).filter(Boolean);
      if (sources.length !== 3) {
        process.exitCode = 2;
        break;
      }
      for (const source of sources) chmodSync(source, 0o600);
      writeFileSync(openlistPreparedMarker, "1001:1001:600");
    } else if (args.some((argument) => argument.endsWith("-openlist-configuration"))) {
      if (!existsSync(openlistPreparedMarker)) process.exitCode = 1;
    } else if (args.some((argument) => argument.endsWith("-openlist-bootstrap"))) {
      if (!existsSync(openlistPreparedMarker) || existsSync(`${process.env.FAKE_DOCKER_LOG}.openlist-bootstrap-failure`)) {
        process.exitCode = 1;
        break;
      }
      const credentialMount = args.find((argument) => argument.includes("target=/run/secrets/session-credential"));
      const credentialSource = credentialMount?.match(/(?:^|,)source=([^,]+),target=\/run\/secrets\/session-credential(?:,|$)/)?.[1];
      const script = args[args.indexOf("-c") + 1] ?? "";
      if (!credentialSource || !script.includes("./openlist admin")) {
        process.exitCode = 2;
        break;
      }
      if (!existsSync(openlistAdminState)) writeFileSync(openlistAdminState, "generated-password");
      if (script.includes("./openlist admin set")) {
        writeFileSync(openlistAdminState, readFileSync(credentialSource, "utf8"));
      }
    }
    if (args.includes("--interactive")) {
      process.stdin.resume();
      process.stdin.once("end", () => process.stdout.write("fake-container-id\n"));
    } else {
      process.stdout.write("fake-container-id\n");
    }
    break;
  case "wait": {
    const interval = setInterval(() => {
      if (existsSync(stoppedMarker)) {
        clearInterval(interval);
        process.stdout.write("0\n");
      }
    }, 10);
    break;
  }
  case "inspect":
    process.stdout.write("true\n");
    break;
  default:
    process.stderr.write("unexpected fake Docker command\n");
    process.exitCode = 2;
}
